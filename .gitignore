# Multimodal Transportation System Model (Lemon Grove).
# Rule: every input a run reads must be tracked; everything a run writes must be ignored, so that a fresh clone
# reproduces docs/reference_results (see docs/progress.md).

# ---- generated by model runs: recreated on every run ----
# FleetPy results
fleetpy/studies/*/results/
results/
# demand that the model hands to FleetPy each iteration
fleetpy/data/demand/lemon_grove_example_demand/matched/lemon_grove_example_network/lemon_grove_debug_*_fleetpy_demand.csv
fleetpy/data/demand/lemon_grove_example_demand/matched/lemon_grove_example_network/debug_*_F_transit_demand_*.csv
/lemon_grove_debug_*_fleetpy_demand.csv
# Lemon Grove inputs copied from mtsm_data/lemon_grove/fleetpy_inputs/ into FleetPy before each run
# (fleetpy_runner.stage_inputs); the tracked originals are in mtsm_data/
fleetpy/data/networks/lemon_grove_example_network/
fleetpy/data/fleetctrl/initial_vehicle_distribution/lemon_grove_example_network/
fleetpy/studies/example_study/scenarios/lemon_grove_*
fleetpy/data/vehicles/lemon_grove_vehtype.csv
# mtsm_data/: outputs and per-run networks (the frozen inputs stay tracked, see mtsm_data/MANIFEST.csv)
mtsm_data/lemon_grove/output/*
mtsm_data/lemon_grove/final_network/*
mtsm_data/lemon_grove/indiv_output/*
mtsm_data/lemon_grove/optimization_output/*
!mtsm_data/lemon_grove/*/.gitkeep
mtsm_data/lemon_grove/initial_network/initial_super_network_*
!mtsm_data/lemon_grove/initial_network/initial_super_network_non_micro_hw_20.csv
mtsm_data/lemon_grove/initial_network_0719/initial_super_network_*
!mtsm_data/lemon_grove/initial_network_0719/initial_super_network_micro_hw_20_virstop_100.csv
# old evaluation outputs (2023), not produced by the current code
eval_output_dir/
*.log

# ---- kept from FleetPy's .gitignore ----
# private simulation scripts (private copies of bugfix_or_run.py with modifications for specific scenarios)
run_private*.py

# system dependent C++ Router files (not used: the Lemon Grove run uses the Python network module)
fleetpy/src/routing/cpp_router/*.pyd
fleetpy/src/routing/cpp_router/build/*
fleetpy/src/routing/cpp_router/PyNetwork.cpp
fleetpy/src/routing/extractors/cache/*

# IDE-related files
*.idea
.vscode/*
fleetpy/src/routing/cpp_router/.vs/*

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
# ... except the lock files of the model's conda env (tools/export_env.py)
!/env/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json
