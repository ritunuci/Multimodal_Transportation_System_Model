# Multimodal Transportation System Model (Lemon Grove).
# Rule: every input a run reads must be tracked; everything a run writes must be ignored, so that a fresh clone
# reproduces docs/reference_results (see docs/progress.md).

# ---- generated by model runs: recreated on every run ----
# FleetPy results
fleetpy/studies/*/results/
results/
# Since 2026-11-24 the patterns below hold for every study area <area> (until then they named lemon_grove).
# demand that the model hands to FleetPy each iteration (the whole <area>_example_demand/ folder is written by the run;
# FleetPy's own example_demand/ does not match)
fleetpy/data/demand/*_example_demand/
/*_debug_*_fleetpy_demand.csv
# a study area's inputs copied from mtsm_data/<area>/fleetpy/ (fleetpy_inputs/ until 2026-11-24) into FleetPy before
# each run (fleetpy_runner.stage_inputs); the tracked originals are in mtsm_data/. FleetPy's own example files do not
# match these patterns, except its two vehicle types (kept tracked by the "!" lines).
fleetpy/data/networks/*_example_network/
fleetpy/data/fleetctrl/initial_vehicle_distribution/*_example_network/
fleetpy/studies/example_study/scenarios/*_constant_config_*
fleetpy/studies/example_study/scenarios/*_example_ir_*
fleetpy/data/vehicles/*_vehtype.csv
!fleetpy/data/vehicles/default_vehtype.csv
!fleetpy/data/vehicles/low_range_vehtype.csv
# mtsm_data/: outputs and per-run networks (the frozen inputs stay tracked, see mtsm_data/MANIFEST.csv and
# mtsm_data/<area>/MANIFEST.csv)
mtsm_data/*/output/*
mtsm_data/*/final_network/*
mtsm_data/*/indiv_output/*
mtsm_data/*/optimization_output/*
# initial_network/ holds only what the run writes since 2026-11-24 (its inputs moved to networks/)
mtsm_data/*/initial_network/*
!mtsm_data/*/*/.gitkeep
# old evaluation outputs (2023), not produced by the current code
eval_output_dir/
*.log

# ---- kept from FleetPy's .gitignore ----
# private simulation scripts (private copies of bugfix_or_run.py with modifications for specific scenarios)
run_private*.py

# system dependent C++ Router files (not used: the Lemon Grove run uses the Python network module)
fleetpy/src/routing/cpp_router/*.pyd
fleetpy/src/routing/cpp_router/build/*
fleetpy/src/routing/cpp_router/PyNetwork.cpp
fleetpy/src/routing/extractors/cache/*

# IDE-related files
*.idea
.vscode/*
fleetpy/src/routing/cpp_router/.vs/*

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
# ... except the lock files of the model's conda env (tools/export_env.py)
!/env/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json
